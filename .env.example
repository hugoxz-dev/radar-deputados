# Copie este arquivo para .env e ajuste os valores:  cp .env.example .env
# NUNCA versione o .env (ele está no .gitignore).

# ---------- Banco de dados ----------
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar_dev
POSTGRES_DB=radar
# Porta do Postgres no seu computador (mude se já tiver outro Postgres na 5432)
POSTGRES_PORTA_HOST=5432
# Usado quando você roda a API/ETL fora do Docker. Dentro do Docker o compose troca "localhost" por "db".
DATABASE_URL=postgresql+psycopg://radar:radar_dev@localhost:5432/radar

# ---------- API ----------
AMBIENTE=desenvolvimento
# Origens que o navegador pode usar para chamar a API (separadas por vírgula)
CORS_ORIGENS=http://localhost:5173

# ---------- Autenticação ----------
# Gere um valor aleatório: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=troque-este-valor
JWT_EXPIRACAO_MINUTOS=1440

# ---------- ETL ----------
CAMARA_API_URL=https://dadosabertos.camara.leg.br/api/v2
# Quantos meses para trás a carga inicial busca
ETL_MESES_CARGA_INICIAL=12
# Pausa entre requisições à API da Câmara (segundos), para não sobrecarregá-la
ETL_PAUSA_SEGUNDOS=0.3
# Quantos deputados são baixados em paralelo (mantenha baixo para não sobrecarregar a API)
ETL_PARALELISMO=3
ETL_TIMEOUT_SEGUNDOS=30
# Tentativas por requisição antes de desistir (com espera crescente entre elas)
ETL_MAX_TENTATIVAS=5

# ---------- Gastos fora do padrão ----------
# Explicação de cada parâmetro: docs/metodologia.md
ANOMALIA_Z_LIMIAR=3.5
ANOMALIA_MIN_GRUPO=30
ANOMALIA_CONCENTRACAO_LIMITE=0.40
ANOMALIA_CONCENTRACAO_MIN_TOTAL=10000
ANOMALIA_CONCENTRACAO_MIN_NOTAS=5
ANOMALIA_REPETIDAS_VALOR_MINIMO=100
ANOMALIA_REPETIDAS_JANELA_DIAS=0
ANOMALIA_MENSAL_RAZAO_MINIMA=2.0
ANOMALIA_MENSAL_MIN_DEPUTADOS=5
ANOMALIA_MENSAL_COMPLETUDE_MINIMA=0.6


# ---------- IA ----------
# template = sem IA (funciona sempre) | anthropic (Claude, precisa de chave) | ollama (modelo local)
# Sem chave configurada, "anthropic" cai automaticamente no template.
LLM_PROVEDOR=template
LLM_PARALELISMO=4
ANTHROPIC_API_KEY=
# claude-opus-5-5 (padrão, melhor qualidade) ou claude-haiku-5-5 (bem mais barato, bom para textos curtos)
ANTHROPIC_MODELO=claude-opus-5-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.1

# ---------- Pagamento ----------
# simulado = "assinar" ativa o Pro direto (para demonstração) | stripe = Stripe em modo de teste
PAGAMENTO_MODO=simulado
# Preço exibido na página de planos, em centavos (no Stripe, o valor cobrado é o do STRIPE_PRICE_ID)
PLANO_PRO_PRECO_CENTAVOS=1990
# Stripe (modo de teste): chave sk_test_..., preço recorrente price_... e segredo do webhook whsec_...
# Sem chave e preço, PAGAMENTO_MODO=stripe cai automaticamente no simulado.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
FRONTEND_URL=http://localhost:5173

# ---------- E-mail ----------
# smtp = envia por SMTP (no Docker, vai para o Mailpit: http://localhost:8025) | console = só imprime no log
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORTA=1025
EMAIL_REMETENTE=alertas@radar-deputados.local

# ---------- Agendador ----------
# Horário do ciclo diário: atualizar dados -> recalcular alertas -> e-mails -> resumos
AGENDA_HORA=6
AGENDA_MINUTO=0
AGENDA_FUSO=America/Sao_Paulo
